# Public repository: customer application, resources, build files and user guides.
# Development material and private data stay local.
/*
!/.gitignore
!/.env.example
!/.python-version
!/README.md
!/LICENSE
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/Start.cmd
!/Start.vbs
!/desktop.py
!/requirements.txt
!/requirements-common.txt
!/requirements-desktop.txt
!/requirements-portable.txt
!/requirements-local-embedding.txt
!/portable-lock.txt

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
!/.github/workflows/desktop-release.yml

!/stylemate/
/stylemate/evaluation/
__pycache__/
*.pyc

!/assets/
/assets/*
!/assets/demo/
/assets/demo/cc_candidates.json

!/data/
/data/*
!/data/knowledge/
/data/knowledge/*
!/data/knowledge/records.jsonl
!/data/knowledge/sources.json

!/docs/
/docs/*
!/docs/guides/
/docs/guides/*
!/docs/guides/DESKTOP.md
!/docs/guides/SETUP.md
!/docs/assets/
/docs/assets/*
!/docs/assets/wardrobe.png
!/docs/assets/chat.png
!/docs/assets/service-setup.png
!/docs/assets/weather-setup.png

!/scripts/
/scripts/*
!/scripts/build_desktop.py
!/scripts/build_portable.py
!/scripts/package_notices.py
!/scripts/lock_runtime.py

!/licenses/
